TARGET_TICKER=CLSK
ALERT_THRESHOLD=5.0
POLL_INTERVAL_MINUTES=15
ENABLE_SCHEDULER=true

# Optional: richer AI attribution and web search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=

# Optional: email delivery (465 = SSL, 587 = STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT=

DATABASE_PATH=data/alerts.db
